{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": { "includes": ["**", "!dist", "!dist-single", "!dist-artifact", "!node_modules", "!test-results", "!playwright-report"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "javascript": { "formatter": { "quoteStyle": "single", "arrowParentheses": "asNeeded" } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off", "noParameterAssign": "off", "useTemplate": "off" },
      "complexity": { "noForEach": "off" },
      "suspicious": { "noAssignInExpressions": "off" }
    }
  }
}
